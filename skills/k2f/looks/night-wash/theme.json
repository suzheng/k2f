{
  "font_aliases": {
    "Roboto-Regular": "Roboto-Regular"
  },
  "palette": {
    "accent": "#7EE787",
    "alt_row": "#21262D",
    "disabled": "#E6EDF361",
    "glass_fill": "#FFFFFF14",
    "header_bg": "#21262D",
    "header_ink": "#E6EDF3",
    "ink": "#E6EDF3",
    "ink_soft": "#8B949E",
    "muted": "#8B949E",
    "paper": "#0D1117",
    "rule": "#30363D",
    "signature": "#161B22",
    "warning_bg": "#3D2A00",
    "warning_ink": "#F0C14B"
  },
  "primitives": {
    "borders": {
      "glass": { "color": "#FFFFFF33", "width_pt": 500 },
      "subtle": { "color": "#FFFFFF1A", "width_pt": 500 }
    },
    "corners": { "large": 16000, "medium": 10000, "none": 0, "small": 4000 },
    "surfaces": {
      "canvas_wash": {
        "type": "linear_gradient",
        "value": {
          "angle_degrees": 155,
          "stops": [
            { "color": "#0D1117", "pos": 0 },
            { "color": "#161B22", "pos": 500 },
            { "color": "#1F2937", "pos": 1000 }
          ],
          "type": "linear"
        }
      },
      "glass_fill": { "color": "glass_fill", "type": "solid" },
      "header_bg": { "color": "header_bg", "type": "solid" },
      "paper": { "color": "paper", "type": "solid" },
      "rule": { "color": "rule", "type": "solid" },
      "signature": { "color": "signature", "type": "solid" },
      "warning_bg": { "color": "warning_bg", "type": "solid" }
    }
  },
  "modifiers": {
    "precedence": ["emphasis", "link", "math"],
    "styles": {
      "emphasis": {
        "emphasis": { "italic": true },
        "strong": { "bold": true, "color": "accent" }
      },
      "link": {
        "default": { "color": "accent", "underline": true }
      },
      "math": {
        "inline": { "color": "ink" }
      }
    }
  },
  "roles": {
    "body": {
      "color": "ink_soft",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "caption": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1300
    },
    "card": {
      "box_decoration": {
        "background": "glass_fill",
        "border": "glass",
        "corner_radius": "medium",
        "padding_pt": 20000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500,
      "variants": {
        "flat": {
          "box_decoration": {
            "background": "signature",
            "border": "subtle",
            "corner_radius": "medium",
            "padding_pt": 20000
          }
        },
        "glass": {
          "box_decoration": {
            "background": "glass_fill",
            "border": "glass",
            "corner_radius": "medium",
            "padding_pt": 20000
          }
        }
      }
    },
    "code": {
      "box_decoration": {
        "background": "signature",
        "border": "subtle",
        "corner_radius": "small",
        "padding_pt": 8000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 10500,
      "line_height_mult": 1400
    },
    "default": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "display": {
      "bold": true,
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 36000,
      "letter_spacing_pt": -500,
      "line_height_mult": 1100,
      "variants": {
        "poster": {
          "text_overrides": {
            "font_size": 60000,
            "letter_spacing_pt": -1200,
            "line_height_mult": 1000
          }
        }
      }
    },
    "document": {
      "box_decoration": { "background": "canvas_wash" },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "h1": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 10000, "left": 0, "right": 0, "top": 0 }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 24000,
      "letter_spacing_pt": -300,
      "line_height_mult": 1200
    },
    "h2": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 8000, "left": 0, "right": 0, "top": 18000 }
      },
      "color": "accent",
      "font_family": "Roboto-Regular",
      "font_size": 18000,
      "line_height_mult": 1250
    },
    "h3": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 6000, "left": 0, "right": 0, "top": 14000 }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 14000,
      "line_height_mult": 1300
    },
    "h4": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 4000, "left": 0, "right": 0, "top": 10000 }
      },
      "color": "ink_soft",
      "font_family": "Roboto-Regular",
      "font_size": 12000,
      "line_height_mult": 1350
    },
    "image": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "self_align": "start"
    },
    "kicker": {
      "bold": true,
      "color": "accent",
      "font_family": "Roboto-Regular",
      "font_size": 10000,
      "letter_spacing_pt": 300,
      "line_height_mult": 1300,
      "variants": {
        "poster": {
          "text_overrides": { "font_size": 12000, "letter_spacing_pt": 400 }
        }
      }
    },
    "list_item": {
      "color": "ink_soft",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "list_style": {
        "bullet_glyph": "-",
        "depth_indent_pt": 18000,
        "marker_box_width_pt": 18000,
        "marker_gap_pt": 4000,
        "number_suffix": "."
      }
    },
    "math": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "text_align": "center"
    },
    "metric": {
      "bold": true,
      "color": "accent",
      "font_family": "Roboto-Regular",
      "font_size": 52000,
      "letter_spacing_pt": -800,
      "line_height_mult": 1000,
      "variants": {
        "poster": {
          "text_overrides": {
            "color": "accent",
            "font_size": 78000,
            "letter_spacing_pt": -1200
          }
        }
      }
    },
    "quote": {
      "box_decoration": {
        "padding_pt": { "bottom": 10000, "left": 16000, "right": 0, "top": 0 }
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "rule": {
      "box_decoration": { "background": "rule" },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 2000,
      "line_height_mult": 1000
    },
    "running_footer": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200
    },
    "running_header": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200
    },
    "section": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "shell": {
      "box_decoration": {
        "background": "canvas_wash",
        "padding_pt": 44000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "signature_block": {
      "box_decoration": {
        "background": "signature",
        "border": "subtle",
        "padding_pt": 16000
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table_header_cell": {
      "box_decoration": {
        "background": "header_bg",
        "corner_radius": "small",
        "padding_pt": 6000
      },
      "color": "header_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table_row_cell": {
      "box_decoration": { "padding_pt": 6000 },
      "color": "ink_soft",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "alt": {
          "box_decoration": {
            "background": "alt_row",
            "padding_pt": 6000
          }
        }
      }
    },
    "warning": {
      "box_decoration": {
        "background": "warning_bg",
        "border": "subtle",
        "corner_radius": "small",
        "padding_pt": 12000
      },
      "color": "warning_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    }
  }
}
