{
  "font_aliases": {
    "Roboto-Regular": "Roboto-Regular"
  },
  "palette": {
    "accent": "#1A535C",
    "alt_row": "#F0F4F8",
    "block_coral": "#FF6B6B",
    "block_navy": "#2D3047",
    "block_teal": "#4ECDC4",
    "disabled": "#2D304761",
    "header_bg": "#2D3047",
    "header_ink": "#FFFFFF",
    "ink": "#2D3047",
    "muted": "#5C6370",
    "on_block": "#FFFFFF",
    "on_block_muted": "#FFFFFFCC",
    "paper": "#FFFFFF",
    "rule": "#D0D7DE",
    "signature": "#F0F4F8",
    "warning_bg": "#FFF3CD",
    "warning_ink": "#856404"
  },
  "primitives": {
    "borders": {
      "contrast": { "color": "#2D304733", "width_pt": 800 },
      "subtle": { "color": "#2D30471A", "width_pt": 500 }
    },
    "corners": { "large": 20000, "medium": 12000, "none": 0, "small": 6000 },
    "surfaces": {
      "block_coral": { "color": "block_coral", "type": "solid" },
      "block_navy": { "color": "block_navy", "type": "solid" },
      "block_teal": { "color": "block_teal", "type": "solid" },
      "header_bg": { "color": "header_bg", "type": "solid" },
      "paper": { "color": "paper", "type": "solid" },
      "rule": { "color": "rule", "type": "solid" },
      "signature": { "color": "signature", "type": "solid" },
      "warning_bg": { "color": "warning_bg", "type": "solid" }
    }
  },
  "modifiers": {
    "precedence": ["emphasis", "link", "math"],
    "styles": {
      "emphasis": {
        "emphasis": { "italic": true },
        "strong": { "bold": true }
      },
      "link": {
        "default": { "color": "accent", "underline": true }
      },
      "math": {
        "inline": { "color": "ink" }
      }
    }
  },
  "roles": {
    "body": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500
    },
    "caption": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1300
    },
    "card": {
      "box_decoration": {
        "background": "block_teal",
        "corner_radius": "medium",
        "padding_pt": 20000
      },
      "color": "on_block",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500,
      "variants": {
        "block_a": {
          "box_decoration": {
            "background": "block_teal",
            "corner_radius": "medium",
            "padding_pt": 20000
          },
          "text_overrides": { "color": "on_block" }
        },
        "block_b": {
          "box_decoration": {
            "background": "block_coral",
            "corner_radius": "medium",
            "padding_pt": 20000
          },
          "text_overrides": { "color": "on_block" }
        },
        "block_c": {
          "box_decoration": {
            "background": "block_navy",
            "corner_radius": "medium",
            "padding_pt": 20000
          },
          "text_overrides": { "color": "on_block" }
        },
        "flat": {
          "box_decoration": {
            "background": "paper",
            "border": "subtle",
            "corner_radius": "medium",
            "padding_pt": 20000
          },
          "text_overrides": { "color": "ink" }
        }
      }
    },
    "code": {
      "box_decoration": {
        "background": "signature",
        "corner_radius": "small",
        "padding_pt": 8000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 10500,
      "line_height_mult": 1400
    },
    "default": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500
    },
    "display": {
      "bold": true,
      "color": "block_navy",
      "font_family": "Roboto-Regular",
      "font_size": 36000,
      "letter_spacing_pt": -500,
      "line_height_mult": 1100,
      "variants": {
        "poster": {
          "text_overrides": {
            "color": "block_navy",
            "font_size": 58000,
            "letter_spacing_pt": -1000,
            "line_height_mult": 1000
          }
        }
      }
    },
    "document": {
      "box_decoration": { "background": "paper" },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500
    },
    "h1": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 10000, "left": 0, "right": 0, "top": 0 }
      },
      "color": "block_navy",
      "font_family": "Roboto-Regular",
      "font_size": 24000,
      "line_height_mult": 1200
    },
    "h2": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 8000, "left": 0, "right": 0, "top": 18000 }
      },
      "color": "accent",
      "font_family": "Roboto-Regular",
      "font_size": 18000,
      "line_height_mult": 1250
    },
    "h3": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 6000, "left": 0, "right": 0, "top": 14000 }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 14000,
      "line_height_mult": 1300
    },
    "h4": {
      "bold": true,
      "box_decoration": {
        "padding_pt": { "bottom": 4000, "left": 0, "right": 0, "top": 10000 }
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 12000,
      "line_height_mult": 1350
    },
    "image": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "self_align": "start"
    },
    "kicker": {
      "bold": true,
      "color": "block_coral",
      "font_family": "Roboto-Regular",
      "font_size": 10000,
      "letter_spacing_pt": 200,
      "line_height_mult": 1300,
      "variants": {
        "poster": {
          "text_overrides": { "font_size": 12000, "letter_spacing_pt": 300 }
        }
      }
    },
    "list_item": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "list_style": {
        "bullet_glyph": "-",
        "depth_indent_pt": 18000,
        "marker_box_width_pt": 18000,
        "marker_gap_pt": 4000,
        "number_suffix": "."
      }
    },
    "math": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "text_align": "center"
    },
    "metric": {
      "bold": true,
      "color": "block_coral",
      "font_family": "Roboto-Regular",
      "font_size": 52000,
      "letter_spacing_pt": -600,
      "line_height_mult": 1000,
      "variants": {
        "poster": {
          "text_overrides": {
            "color": "block_coral",
            "font_size": 76000,
            "letter_spacing_pt": -1000
          }
        }
      }
    },
    "quote": {
      "box_decoration": {
        "padding_pt": { "bottom": 10000, "left": 16000, "right": 0, "top": 0 }
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1600
    },
    "rule": {
      "box_decoration": { "background": "rule" },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 2000,
      "line_height_mult": 1000
    },
    "running_footer": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200
    },
    "running_header": {
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200
    },
    "section": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500
    },
    "shell": {
      "box_decoration": {
        "background": "paper",
        "padding_pt": 40000
      },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500
    },
    "signature_block": {
      "box_decoration": {
        "background": "signature",
        "padding_pt": 16000
      },
      "color": "muted",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table": {
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table_header_cell": {
      "box_decoration": {
        "background": "header_bg",
        "corner_radius": "small",
        "padding_pt": 6000
      },
      "color": "header_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    },
    "table_row_cell": {
      "box_decoration": { "padding_pt": 6000 },
      "color": "ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "variants": {
        "alt": {
          "box_decoration": {
            "background": "alt_row",
            "padding_pt": 6000
          }
        }
      }
    },
    "warning": {
      "box_decoration": {
        "background": "warning_bg",
        "corner_radius": "small",
        "padding_pt": 12000
      },
      "color": "warning_ink",
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400
    }
  }
}
