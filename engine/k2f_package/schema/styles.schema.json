{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k2f://schema/styles.schema.json",
  "title": "K2F Styles / Theme Schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "list_style": {
      "type": "object",
      "description": "Optional list layout tokens (marker box, indentation, and marker strings).",
      "additionalProperties": false,
      "properties": {
        "marker_box_width_pt": {
          "type": "integer",
          "description": "Fixed-width marker box in 1/1000 pt units."
        },
        "marker_gap_pt": {
          "type": "integer",
          "description": "Gap between marker box and body text start in 1/1000 pt units."
        },
        "depth_indent_pt": {
          "type": "integer",
          "description": "Additional indent per nesting depth level in 1/1000 pt units."
        },
        "marker_align": {
          "enum": ["start", "center", "end"],
          "description": "Alignment of the marker within the fixed-width marker box."
        },
        "bullet_glyph": {
          "type": "string",
          "description": "Glyph used for bullet markers.",
          "default": "•"
        },
        "number_suffix": {
          "type": "string",
          "description": "Suffix appended to the number marker (e.g. '.' yields '1.').",
          "default": "."
        }
      }
    }
  },
  "properties": {
    "palette": {
      "type": "object",
      "description": "Named colors. The only color table; roles and primitives reference these keys or hex.",
      "additionalProperties": { "type": "string" }
    },
    "primitives": {
      "type": "object",
      "description": "Named visual atoms referenced by role/variant box_decoration.",
      "additionalProperties": false,
      "properties": {
        "surfaces": {
          "type": "object",
          "description": "Named fills used for backgrounds and surfaces.",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/fill" }
        },
        "gradients": {
          "type": "object",
          "description": "Named gradients for reuse.",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/linear_gradient" }
        },
        "shadows": {
          "type": "object",
          "description": "Named compound shadows (one or more layers).",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/shadow" }
        },
        "blurs": {
          "type": "object",
          "description": "Named blur definitions.",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/blur" }
        },
        "corners": {
          "type": "object",
          "description": "Named corner radii in 1/1000 pt units.",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/pt_nonneg" }
        },
        "borders": {
          "type": "object",
          "description": "Named borders (width + color).",
          "additionalProperties": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/border" }
        }
      }
    },
    "roles": {
      "type": "object",
      "description": "Role -> base style mapping. Must include 'default'.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "font_family": { "type": "string" },
          "font_size": {
            "type": "integer",
            "description": "Fixed-point Pt in 1/1000 pt units (e.g. 12000 = 12pt)."
          },
          "line_height_mult": {
            "type": "integer",
            "description": "Line height multiplier in 1/1000 units (e.g. 1200 = 1.2x)."
          },
          "letter_spacing_pt": {
            "type": "integer",
            "description": "Extra advance between glyphs in 1/1000 pt (may be negative). Default 0."
          },
          "first_line_indent_pt": {
            "type": "integer",
            "minimum": 0,
            "description": "First-line indent in 1/1000 pt. Applies only to the first wrapped line of a text node."
          },
          "color": { "type": "string" },
          "text_align": {
            "enum": ["start", "center", "end", "justify"],
            "description": "Text alignment within the text box.",
            "default": "start"
          },
          "bold": {
            "type": "boolean",
            "description": "Role-level bold. Defaults to false.",
            "default": false
          },
          "italic": {
            "type": "boolean",
            "description": "Role-level italic. Defaults to false.",
            "default": false
          },
          "self_align": {
            "enum": ["start", "center", "end", "stretch"],
            "description": "Overrides the parent container's cross-axis alignment for this item.",
            "default": null
          },
          "box_decoration": {
            "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/box_decoration",
            "description": "Optional box decoration applied when the role is used on containers or decorated boxes."
          },
          "list_style": {
            "$ref": "#/$defs/list_style",
            "description": "Optional list layout tokens for this role."
          },
          "variants": {
            "type": "object",
            "description": "Variant name -> style additions/overrides for this role.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "box_decoration": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/box_decoration" },
                "self_align": {
                   "enum": ["start", "center", "end", "stretch"],
                   "description": "Overrides the parent container's cross-axis alignment for this item."
                },
                "text_overrides": { "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/text_style_patch" },
                "list_style": {
                  "$ref": "#/$defs/list_style",
                  "description": "Optional list layout token overrides for this role variant."
                }
              }
            }
          }
        },
        "required": ["font_family", "font_size", "line_height_mult", "color"]
      }
    },
    "font_aliases": {
      "type": "object",
      "description": "Human font names -> loaded font family keys (e.g. 'Helvetica' -> 'default').",
      "additionalProperties": { "type": "string" }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precedence": {
          "type": "array",
          "description": "Modifier type precedence list (low -> high). Higher precedence overrides lower precedence on overlap.",
          "items": { "type": "string" }
        },
        "styles": {
          "type": "object",
          "description": "Modifier type -> intent -> style patch (optional).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "k2f://schema/visual_primitives.schema.json#/$defs/text_style_patch"
            }
          }
        }
      }
    }
  },
  "required": ["palette", "roles"]
}
