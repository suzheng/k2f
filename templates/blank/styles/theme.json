{
  "font_aliases": {
    "Roboto-Regular": "Roboto-Regular",
    "NotoSansMath-Regular": "NotoSansMath-Regular"
  },
  "palette": {
    "ink": "#151515",
    "paper": "#FFFFFF",
    "muted": "#5F6368",
    "accent": "#151515",
    "warning_bg": "#FFEBEE",
    "warning_ink": "#C62828",
    "header_bg": "#151515",
    "header_ink": "#FFFFFF",
    "alt_row": "#F5F5F7",
    "signature": "#F5F5F7",
    "rule": "#D2D2D7",
    "disabled": "#15151561"
  },
  "primitives": {
    "surfaces": {
      "paper": { "type": "solid", "color": "paper" },
      "rule": { "type": "solid", "color": "rule" }
    },
    "corners": { "none": 0, "small": 4000, "medium": 12000 },
    "borders": {
      "subtle": { "color": "#1515151A", "width_pt": 500 }
    }
  },
  "modifiers": {
    "precedence": ["emphasis", "link"],
    "styles": {
      "emphasis": {
        "strong": { "bold": true },
        "emphasis": { "italic": true }
      },
      "link": {
        "default": { "underline": true, "color": "accent" }
      }
    }
  },
  "roles": {
    "default": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink"
    },
    "document": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink",
      "box_decoration": { "background": "paper" }
    },
    "body": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink"
    },
    "h1": {
      "font_family": "Roboto-Regular",
      "font_size": 24000,
      "line_height_mult": 1250,
      "color": "ink",
      "bold": true
    },
    "h2": {
      "font_family": "Roboto-Regular",
      "font_size": 18000,
      "line_height_mult": 1300,
      "color": "ink",
      "bold": true
    },
    "h3": {
      "font_family": "Roboto-Regular",
      "font_size": 14000,
      "line_height_mult": 1350,
      "color": "ink",
      "bold": true
    },
    "h4": {
      "font_family": "Roboto-Regular",
      "font_size": 12000,
      "line_height_mult": 1400,
      "color": "ink",
      "bold": true
    },
    "warning": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "warning_ink",
      "box_decoration": {
        "background": "warning_bg",
        "corner_radius": "small",
        "padding_pt": 12000
      }
    },
    "section": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1350,
      "color": "ink"
    },
    "table": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "ink"
    },
    "table_header_cell": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "header_ink",
      "box_decoration": {
        "background": "header_bg",
        "corner_radius": "small",
        "padding_pt": 6000
      }
    },
    "table_row_cell": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "ink",
      "box_decoration": { "padding_pt": 6000 }
    },
    "list_item": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1500,
      "color": "ink",
      "list_style": {
        "bullet_glyph": "-",
        "depth_indent_pt": 18000,
        "marker_box_width_pt": 18000,
        "marker_gap_pt": 4000,
        "number_suffix": "."
      }
    },
    "math": {
      "font_family": "NotoSansMath-Regular",
      "font_size": 11000,
      "line_height_mult": 1600,
      "color": "ink",
      "text_align": "center"
    },
    "running_header": {
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "color": "muted"
    },
    "running_footer": {
      "font_family": "Roboto-Regular",
      "font_size": 9000,
      "line_height_mult": 1200,
      "color": "muted"
    },
    "signature_block": {
      "font_family": "Roboto-Regular",
      "font_size": 11000,
      "line_height_mult": 1400,
      "color": "muted",
      "box_decoration": {
        "background": "signature",
        "padding_pt": 16000
      }
    },
    "rule": {
      "font_family": "Roboto-Regular",
      "font_size": 2000,
      "line_height_mult": 1000,
      "color": "muted",
      "box_decoration": { "background": "rule" }
    }
  }
}
